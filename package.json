{
	"name": "blade-intelephense-bridge",
	"displayName": "Blade Intelephense Bridge",
	"description": "Full PHP Intelephense intelligence inside .blade.php files for custom PHP/Blade frameworks — completions, method snippets, auto-import, hover, go-to-definition, and diagnostics.",
	"version": "3.0.11",
	"publisher": "spectabile",
	"author": {
		"name": "SPECTABILE."
	},
	"icon": "icon.png",
	"license": "MIT",
	"homepage": "https://github.com/spectabile/blade-intelephense-bridge",
	"repository": {
		"type": "git",
		"url": "https://github.com/spectabile/blade-intelephense-bridge"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Programming Languages",
		"Linters"
	],
	"keywords": [
		"blade",
		"laravel",
		"php",
		"intelephense",
		"autocomplete"
	],
	"activationEvents": [
		"onLanguage:blade"
	],
	"main": "./extension.js",
	"contributes": {
		"commands": [
			{
				"command": "bladeBridge.importClass",
				"title": "Blade: Import Class"
			},
			{
				"command": "bladeBridge.diagnose",
				"title": "Blade Bridge: Diagnose"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "bladeBridge.importClass",
					"when": "editorLangId == blade",
					"group": "1_modification"
				}
			]
		},
		"configuration": {
			"title": "Blade Intelephense Bridge",
			"properties": {
				"bladeBridge.debug": {
					"type": "boolean",
					"default": false,
					"description": "Show debug output in the Blade Bridge output channel. Enable when troubleshooting."
				},
				"bladeBridge.diagnostics.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Report PHP errors and warnings in blade files via the Intelephense language server."
				}
			}
		}
	},
	"devDependencies": {
		"@types/vscode": "^1.85.0"
	}
}
